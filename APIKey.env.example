# ===========================================================================
# APIKey.env.example —— 配置模板
#
# 用法：把本文件复制一份并重命名为 APIKey.env，然后填入你自己的密钥。
#       APIKey.env 已被 .gitignore 忽略，请勿提交到公开仓库。
# ===========================================================================

# ---------- 各云厂商密钥（按需填写，只填用到的那几个即可） ----------
DEEPSEEK_API_KEY=sk-在此填入你的DeepSeek密钥
TENCENT_API_KEY=sk-在此填入你的腾讯混元密钥
ZHIPU_API_KEY=在此填入你的智谱密钥
QWEN_API_KEY=sk-在此填入你的通义千问密钥

# ---------- RAG 知识库开关 ----------
# 1 = 启用（默认）；0 = 关闭。关闭后问答不再注入课程知识库片段。
RAG_ENABLED=1

# ---------- 本地 Ollama（可选，用于「DeepSeek本地」模式） ----------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=deepseek-v2:16b

# 说明：RAG 的检索端（rag_service.py）在启动时读取嵌入模型等参数。
#       由于 app.py 中模块导入早于 .env 加载，
#       OLLAMA_EMBED_MODEL / RAG_TOP_K / RAG_MIN_SCORE / RAG_INDEX_PATH
#       写在 .env 里不会生效，需改用系统环境变量设置。
